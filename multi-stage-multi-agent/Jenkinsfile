pipeline {
    agent any

    stages {
        stage('Prepare HTML') {
            steps {
                script {
                    writeFile file: 'index.html', text: '''
<html>
  <head><title>Hello from Apache</title></head>
  <body>
    <h1>This is served by Apache running in Docker</h1>
  </body>
</html>
'''
                }
            }
        }

        stage('Cleanup Old Container') {
            steps {
                sh '''
                    if [ "$(docker ps -aq -f name=apache-server)" ]; then
                        docker stop apache-server || true
                        docker rm apache-server || true
                    fi
                '''
            }
        }

        stage('Run Apache with HTML') {
            steps {
                sh '''
                    docker run -d \
                      -p 8888:80 \
                      --name apache-server \
                      -v $(pwd)/index.html:/usr/local/apache2/htdocs/index.html \
                      httpd:latest
                '''
            }
        }

        stage('Test Page') {
            steps {
                sh 'curl -I http://localhost:8888 || true'
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker stop apache-server || true'
                sh 'docker rm apache-server || true'
            }
        }
    }
}
