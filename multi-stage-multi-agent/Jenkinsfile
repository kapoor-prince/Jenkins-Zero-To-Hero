pipeline {
    agent any

    stages {
        stage('Prepare HTML') {
            steps {
                script {
                    writeFile file: 'index.html', text: '''
<html>
  <head><title>Live Apache Page</title></head>
  <body>
    <h1>Hello Prince How Are you!</h1>
  </body>
</html>
'''
                }
            }
        }

        stage('Cleanup Old Container') {
            steps {
                sh '''
                    if [ "$(docker ps -aq -f name=apache-server)" ]; then
                        docker stop apache-server || true
                        docker rm apache-server || true
                    fi
                '''
            }
        }

        stage('Run Apache Server (Live)') {
            steps {
                sh '''
                    docker run -d \
                      -p 8888:80 \
                      --name apache-server \
                      -v $(pwd)/index.html:/usr/local/apache2/htdocs/index.html \
                      httpd:latest
                '''
            }
        }

        stage('Confirm Running') {
            steps {
                sh 'docker ps | grep apache-server'
                echo 'Visit http://<your-server-ip>:8888 in your browser to view the HTML page.'
            }
        }
        
        stage('Open Firewall Port') {
            steps {
                sh '''
                    echo "Trying to open firewall port 8888"
                    sudo ufw allow 8888 || echo "Cannot open port, check sudo permissions"
                '''
            }
        }

        stage('Show Access Info') {
            steps {
                sh '''
                    echo "🔗 Open this URL in your browser:"
                    echo "http://$(hostname -I | awk '{print $1}'):8888"
                '''
            }
        }
    }
}
