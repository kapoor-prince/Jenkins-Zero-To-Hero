pipeline {
    agent any

    stages {
        stage('Run Apache Server') {
            steps {
                sh 'docker run -d -p 8888:80 --name apache-server httpd:latest'
                sh 'docker ps'
                sh 'curl -I http://localhost:8888'
                sh 'curl -s ifconfig.me'
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker stop apache-server'
                sh 'docker rm apache-server'
            }
        }
    }
}
